<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    tools:context=".ui.ProfileFragment">

    <!-- Top Navy Profile Banner -->

    <!-- Scrollable Profile Form -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingTop="@dimen/_12sdp"
        android:paddingBottom="@dimen/_20sdp"
        app:layout_constraintBottom_toTopOf="@id/bottomSaveBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical">

            <!-- Card 1: Account Email (Read-Only) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="@dimen/_12sdp"
                app:cardElevation="0dp"
                app:strokeColor="#EAECF0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/_14sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/manrope_bold"
                            android:text="Registered Email"
                            android:textColor="@color/btn_navy"
                            android:textSize="@dimen/_11ssp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_rounded_soft_gold"
                            android:fontFamily="@font/manrope_semibold"
                            android:paddingHorizontal="@dimen/_8sdp"
                            android:paddingVertical="@dimen/_2sdp"
                            android:text="Verified"
                            android:textColor="@color/btn_navy"
                            android:textSize="@dimen/_8ssp" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/etProfileEmail"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:background="@drawable/bg_input_field_readonly"
                        android:clickable="false"
                        android:cursorVisible="false"
                        android:enabled="false"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:fontFamily="@font/manrope_medium"
                        android:inputType="none"
                        android:paddingHorizontal="@dimen/_12sdp"
                        android:textColor="#667085"
                        android:textSize="@dimen/_10ssp"
                        tools:text="usman@example.com" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:fontFamily="@font/manrope_regular"
                        android:text="Email address is linked to your account and cannot be changed."
                        android:textColor="#98A2B3"
                        android:textSize="@dimen/_8ssp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Editable Personal Details -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="@dimen/_12sdp"
                app:cardElevation="0dp"
                app:strokeColor="#EAECF0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/_14sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/manrope_bold"
                        android:text="Personal Information"
                        android:textColor="@color/btn_navy"
                        android:textSize="@dimen/_12ssp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:fontFamily="@font/manrope_regular"
                        android:text="Update your passenger profile details below"
                        android:textColor="#667085"
                        android:textSize="@dimen/_9ssp" />

                    <!-- Title Selection -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:fontFamily="@font/manrope_semibold"
                        android:text="Title *"
                        android:textColor="#344054"
                        android:textSize="@dimen/_10ssp" />

                    <RadioGroup
                        android:id="@+id/rgTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rbMr"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/_16sdp"
                            android:buttonTint="@color/btn_navy"
                            android:checked="true"
                            android:fontFamily="@font/manrope_medium"
                            android:text="Mr"
                            android:textColor="@color/text_color_on_light"
                            android:textSize="@dimen/_10ssp" />

                        <RadioButton
                            android:id="@+id/rbMrs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/_16sdp"
                            android:buttonTint="@color/btn_navy"
                            android:fontFamily="@font/manrope_medium"
                            android:text="Mrs"
                            android:textColor="@color/text_color_on_light"
                            android:textSize="@dimen/_10ssp" />

                        <RadioButton
                            android:id="@+id/rbMiss"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/btn_navy"
                            android:fontFamily="@font/manrope_medium"
                            android:text="Miss"
                            android:textColor="@color/text_color_on_light"
                            android:textSize="@dimen/_10ssp" />
                    </RadioGroup>

                    <!-- Full Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:fontFamily="@font/manrope_semibold"
                        android:text="Full Name *"
                        android:textColor="#344054"
                        android:textSize="@dimen/_10ssp" />

                    <EditText
                        android:id="@+id/etProfileName"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:background="@drawable/bg_input_field"
                        android:fontFamily="@font/manrope_regular"
                        android:hint="Enter your full name"
                        android:imeOptions="actionNext"
                        android:inputType="textPersonName|textCapWords"
                        android:paddingHorizontal="@dimen/_12sdp"
                        android:textColor="@color/text_color_on_light"
                        android:textColorHint="#98A2B3"
                        android:textSize="@dimen/_10ssp" />

                    <!-- Mobile Number -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:fontFamily="@font/manrope_semibold"
                        android:text="Mobile Number *"
                        android:textColor="#344054"
                        android:textSize="@dimen/_10ssp" />

                    <EditText
                        android:id="@+id/etProfilePhone"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:background="@drawable/bg_input_field"
                        android:fontFamily="@font/manrope_regular"
                        android:hint="03XX-XXXXXXX"
                        android:imeOptions="actionNext"
                        android:inputType="phone"
                        android:maxLength="12"
                        android:paddingHorizontal="@dimen/_12sdp"
                        android:textColor="@color/text_color_on_light"
                        android:textColorHint="#98A2B3"
                        android:textSize="@dimen/_10ssp" />

                    <!-- CNIC Number -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:fontFamily="@font/manrope_semibold"
                        android:text="CNIC Number *"
                        android:textColor="#344054"
                        android:textSize="@dimen/_10ssp" />

                    <EditText
                        android:id="@+id/etProfileCnic"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:background="@drawable/bg_input_field"
                        android:digits="0123456789-"
                        android:fontFamily="@font/manrope_regular"
                        android:hint="33100-1234567-1"
                        android:imeOptions="actionDone"
                        android:inputType="number"
                        android:maxLength="15"
                        android:paddingHorizontal="@dimen/_12sdp"
                        android:textColor="@color/text_color_on_light"
                        android:textColorHint="#98A2B3"
                        android:textSize="@dimen/_10ssp" />

                    <!-- Gender -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:fontFamily="@font/manrope_semibold"
                        android:text="Gender *"
                        android:textColor="#344054"
                        android:textSize="@dimen/_10ssp" />

                    <RadioGroup
                        android:id="@+id/rgGender"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rbMale"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/_20sdp"
                            android:buttonTint="@color/btn_navy"
                            android:checked="true"
                            android:fontFamily="@font/manrope_medium"
                            android:text="Male"
                            android:textColor="@color/text_color_on_light"
                            android:textSize="@dimen/_10ssp" />

                        <RadioButton
                            android:id="@+id/rbFemale"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/btn_navy"
                            android:fontFamily="@font/manrope_medium"
                            android:text="Female"
                            android:textColor="@color/text_color_on_light"
                            android:textSize="@dimen/_10ssp" />
                    </RadioGroup>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Sticky Save Button -->
    <LinearLayout
        android:id="@+id/bottomSaveBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:elevation="8dp"
        android:paddingHorizontal="@dimen/_14sdp"
        android:paddingVertical="@dimen/_12sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnUpdateProfile"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_42sdp"
            android:background="@drawable/bg_seat_selected"
            android:fontFamily="@font/manrope_bold"
            android:text="Save Changes"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_11ssp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>