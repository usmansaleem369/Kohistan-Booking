<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/_16sdp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="@dimen/_14sdp"
    app:cardElevation="0dp"
    app:strokeColor="#EAECF0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/_18sdp">

        <!-- Soft Red Warning Badge -->
        <FrameLayout
            android:layout_width="@dimen/_44sdp"
            android:layout_height="@dimen/_44sdp"
            android:background="@drawable/bg_circle_soft_red">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/manrope_bold"
                android:text="!"
                android:textColor="@color/red_textcolor"
                android:textSize="@dimen/_18ssp" />
        </FrameLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:fontFamily="@font/manrope_bold"
            android:text="Cancel Ticket?"
            android:textColor="@color/btn_navy"
            android:textSize="@dimen/_14ssp" />

        <!-- Message -->
        <TextView
            android:id="@+id/tvDialogMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:fontFamily="@font/manrope_regular"
            android:gravity="center"
            android:lineSpacingExtra="@dimen/_2sdp"
            android:textColor="#667085"
            android:textSize="@dimen/_10ssp"
            tools:text="Are you sure you want to cancel reservation #2611131014655 (Faisalabad to Gujranwala)? This action cannot be undone." />

        <!-- Action Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_18sdp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKeepTicket"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/_40sdp"
                android:layout_marginEnd="@dimen/_6sdp"
                android:layout_weight="1"
                android:fontFamily="@font/manrope_semibold"
                android:text="No, Keep"
                android:textAllCaps="false"
                android:textColor="@color/btn_navy"
                android:textSize="@dimen/_10ssp"
                app:cornerRadius="@dimen/_8sdp"
                app:strokeColor="#D0D5DD"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmCancel"
                android:layout_width="0dp"
                android:layout_height="@dimen/_40sdp"
                android:layout_marginStart="@dimen/_6sdp"
                android:layout_weight="1"
                android:backgroundTint="@color/red_textcolor"
                android:fontFamily="@font/manrope_bold"
                android:text="Yes, Cancel"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="@dimen/_10ssp"
                app:cornerRadius="@dimen/_8sdp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>