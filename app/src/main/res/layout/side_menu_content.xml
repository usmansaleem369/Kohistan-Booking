<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/side_menu_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/_10sdp">

    <!-- Profile Section -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_30sdp"
        android:foreground="@drawable/profile_image_overlay"
        android:padding="@dimen/_10sdp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/imgProfile"
            android:layout_width="@dimen/_60sdp"
            android:layout_height="@dimen/_60sdp"
            android:background="@drawable/circle_bg"
            android:scaleType="centerCrop"
            android:src="@drawable/profile_placeholder" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvUserName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/white"
        android:fontFamily="@font/manrope_regular"
        android:textSize="@dimen/_6ssp" />

    <TextView
        android:id="@+id/tvUserEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:fontFamily="@font/manrope_regular"
        android:textSize="@dimen/_6ssp" />

    <!-- Menu Buttons -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnHome"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:backgroundTint="@color/white"
        android:gravity="start|center_vertical"
        android:padding="@dimen/_5sdp"
        android:text="@string/home"
        android:textAllCaps="false"
        android:textColor="@color/side_menu_nav_selector"
        android:textSize="@dimen/_8ssp"
        android:fontFamily="@font/manrope_regular"
        app:cornerRadius="@dimen/_10sdp"
        app:icon="@drawable/ic_home"
        app:iconGravity="textStart"
        app:iconPadding="5dp"
        app:iconSize="@dimen/_18sdp"
        app:iconTint="@null" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnProfile"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:backgroundTint="@color/white"
        android:gravity="start|center_vertical"
        android:padding="@dimen/_5sdp"
        android:text="@string/profile"
        android:fontFamily="@font/manrope_regular"
        android:textAllCaps="false"
        android:textColor="@color/side_menu_nav_selector"
        android:textSize="@dimen/_8ssp"
        app:cornerRadius="@dimen/_10sdp"
        app:icon="@drawable/ic_profile"
        app:iconGravity="textStart"
        app:iconPadding="5dp"
        app:iconSize="@dimen/_18sdp"
        app:iconTint="@null" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBookings"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:backgroundTint="@color/white"
        android:gravity="start|center_vertical"
        android:padding="@dimen/_5sdp"
        android:fontFamily="@font/manrope_regular"
        android:text="@string/bookings"
        android:textAllCaps="false"
        android:textColor="@color/side_menu_nav_selector"
        android:textSize="@dimen/_8ssp"
        app:cornerRadius="@dimen/_10sdp"
        app:icon="@drawable/ic_tickets"
        app:iconGravity="textStart"
        app:iconPadding="5dp"
        app:iconSize="@dimen/_18sdp"
        app:iconTint="@null" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSettings"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:backgroundTint="@color/white"
        android:gravity="start|center_vertical"
        android:padding="@dimen/_5sdp"
        android:text="@string/settings"
        android:textAllCaps="false"
        android:fontFamily="@font/manrope_regular"
        android:textColor="@color/side_menu_nav_selector"
        android:textSize="@dimen/_8ssp"
        app:cornerRadius="@dimen/_10sdp"
        app:icon="@drawable/ic_settings"
        app:iconGravity="textStart"
        app:iconPadding="5dp"
        app:iconSize="@dimen/_18sdp"
        app:iconTint="@null" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPrivacy"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:backgroundTint="@color/white"
        android:gravity="start|center_vertical"
        android:fontFamily="@font/manrope_regular"
        android:padding="@dimen/_5sdp"
        android:text="@string/privacy_amp_terms"
        android:textAllCaps="false"
        android:textColor="@color/side_menu_nav_selector"
        android:textSize="@dimen/_8ssp"
        app:cornerRadius="@dimen/_10sdp"
        app:icon="@drawable/ic_privacy"
        app:iconGravity="textStart"
        app:iconPadding="5dp"
        app:iconSize="@dimen/_18sdp"
        app:iconTint="@null" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogout"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:backgroundTint="@color/white"
        android:gravity="start|center_vertical"
        android:fontFamily="@font/manrope_regular"
        android:padding="@dimen/_5sdp"
        android:text="@string/logout"
        android:textAllCaps="false"
        android:textColor="@color/side_menu_nav_selector"
        android:textSize="@dimen/_8ssp"
        app:cornerRadius="@dimen/_10sdp"
        app:icon="@drawable/ic_logout"
        app:iconGravity="textStart"
        app:iconPadding="5dp"
        app:iconSize="@dimen/_18sdp"
        app:iconTint="@null" />



</LinearLayout>
