<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/_16sdp"
    android:paddingTop="@dimen/_10sdp"
    android:paddingBottom="@dimen/_20sdp">

    <!-- Drag Handle -->
    <View
        android:layout_width="@dimen/_36sdp"
        android:layout_height="@dimen/_4sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/_14sdp"
        android:background="@color/btn_gold" />

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical">


        <TextView
            android:id="@+id/tvSheetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope_bold"
            android:textColor="@color/btn_navy"
            android:textSize="@dimen/_12ssp"
            tools:text="Seat 12 — Passenger Gender" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:fontFamily="@font/manrope_regular"
            android:text="@string/choose_who_will_be_occupying_this_seat"
            android:textColor="@color/text_color_on_light"
            android:textSize="@dimen/_8ssp" />
    </LinearLayout>

    <!-- Male & Female Option Cards -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Male Card -->
        <LinearLayout
            android:id="@+id/cardMale"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_8sdp"
            android:layout_weight="1"
            android:background="@drawable/bg_gender_card_male"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/_10sdp">

            <TextView
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_25sdp"
                android:background="@drawable/bg_seat_booked_male"
                android:fontFamily="@font/manrope_bold"
                android:gravity="center"
                android:text="M"
                android:textColor="@color/btn_navy"
                android:textSize="@dimen/_13ssp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:fontFamily="@font/manrope_bold"
                android:text="Male"
                android:textColor="@color/btn_navy"
                android:textSize="@dimen/_10ssp" />
        </LinearLayout>

        <!-- Female Card -->
        <LinearLayout
            android:id="@+id/cardFemale"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_weight="1"
            android:background="@drawable/bg_gender_card_female"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/_10sdp">

            <TextView
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_25sdp"
                android:background="@drawable/bg_seat_booked_female"
                android:fontFamily="@font/manrope_bold"
                android:gravity="center"
                android:text="F"
                android:textColor="@color/seat_selected_female"
                android:textSize="@dimen/_13ssp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:fontFamily="@font/manrope_bold"
                android:text="Female"
                android:textColor="@color/seat_selected_female"
                android:textSize="@dimen/_10ssp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>