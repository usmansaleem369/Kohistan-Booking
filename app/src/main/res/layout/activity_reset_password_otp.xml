<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.ResetPasswordOtpActivity">

    <!-- Top Warm Header -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/card_bg_warm"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_14sdp"
        android:paddingVertical="@dimen/_14sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="@dimen/_26sdp"
            android:layout_height="@dimen/_26sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="@dimen/_3sdp"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_bold"
                android:text="@string/verify_amp_reset_password"
                android:textColor="@color/btn_navy"
                android:textSize="@dimen/_14ssp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:fontFamily="@font/manrope_regular"
                android:text="@string/enter_the_6_digit_otp_and_set_a_new_password"
                android:textColor="@color/text_color_on_light"
                android:textSize="@dimen/_9ssp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingTop="@dimen/_12sdp"
        android:paddingBottom="@dimen/_24sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card 1: OTP Verification -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_bg_warm"
                app:cardCornerRadius="@dimen/_12sdp"
                app:cardElevation="0dp"
                app:strokeColor="#EAECF0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/_14sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/manrope_bold"
                        android:text="@string/otp_verification"
                        android:textColor="@color/btn_navy"
                        android:textSize="@dimen/_12ssp" />

                    <TextView
                        android:id="@+id/tvOtpSentTo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:fontFamily="@font/manrope_regular"
                        android:textColor="@color/text_color_on_light"
                        android:textSize="@dimen/_9ssp"
                        tools:text="We sent a 6-digit code to usman@example.com" />

                    <!-- 6-Digit OTP Boxes -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_14sdp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etOtp1"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/_42sdp"
                            android:layout_marginEnd="@dimen/_5sdp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_input_field"
                            android:fontFamily="@font/manrope_bold"
                            android:gravity="center"
                            android:imeOptions="actionNext"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textColor="@color/btn_navy"
                            android:textSize="@dimen/_13ssp" />

                        <EditText
                            android:id="@+id/etOtp2"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/_42sdp"
                            android:layout_marginEnd="@dimen/_5sdp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_input_field"
                            android:fontFamily="@font/manrope_bold"
                            android:gravity="center"
                            android:imeOptions="actionNext"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textColor="@color/btn_navy"
                            android:textSize="@dimen/_13ssp" />

                        <EditText
                            android:id="@+id/etOtp3"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/_42sdp"
                            android:layout_marginEnd="@dimen/_5sdp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_input_field"
                            android:fontFamily="@font/manrope_bold"
                            android:gravity="center"
                            android:imeOptions="actionNext"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textColor="@color/btn_navy"
                            android:textSize="@dimen/_13ssp" />

                        <EditText
                            android:id="@+id/etOtp4"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/_42sdp"
                            android:layout_marginEnd="@dimen/_5sdp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_input_field"
                            android:fontFamily="@font/manrope_bold"
                            android:gravity="center"
                            android:imeOptions="actionNext"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textColor="@color/btn_navy"
                            android:textSize="@dimen/_13ssp" />

                        <EditText
                            android:id="@+id/etOtp5"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/_42sdp"
                            android:layout_marginEnd="@dimen/_5sdp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_input_field"
                            android:fontFamily="@font/manrope_bold"
                            android:gravity="center"
                            android:imeOptions="actionNext"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textColor="@color/btn_navy"
                            android:textSize="@dimen/_13ssp" />

                        <EditText
                            android:id="@+id/etOtp6"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/_42sdp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_input_field"
                            android:fontFamily="@font/manrope_bold"
                            android:gravity="center"
                            android:imeOptions="actionNext"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textColor="@color/btn_navy"
                            android:textSize="@dimen/_13ssp" />
                    </LinearLayout>

                    <!-- Resend OTP Timer Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvOtpTimer"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/manrope_regular"
                            android:textColor="@color/text_color_on_light"
                            android:textSize="@dimen/_9ssp"
                            tools:text="Resend code in 00:59" />

                        <TextView
                            android:id="@+id/tvResendOtp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:enabled="false"
                            android:fontFamily="@font/manrope_bold"
                            android:paddingVertical="@dimen/_2sdp"
                            android:text="@string/resend_otp"
                            android:textColor="@color/btn_navy"
                            android:textSize="@dimen/_9ssp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Set New Password -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                app:cardBackgroundColor="@color/card_bg_warm"
                app:cardCornerRadius="@dimen/_12sdp"
                app:cardElevation="0dp"
                app:strokeColor="#EAECF0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/_14sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/manrope_bold"
                        android:text="@string/create_new_password"
                        android:textColor="@color/btn_navy"
                        android:textSize="@dimen/_12ssp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:fontFamily="@font/manrope_regular"
                        android:text="@string/must_be_at_least_6_characters_long"
                        android:textColor="@color/text_color_on_light"
                        android:textSize="@dimen/_9ssp" />

                    <!-- New Password -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:fontFamily="@font/manrope_semibold"
                        android:text="@string/new_password"
                        android:textColor="@color/btn_navy"
                        android:textSize="@dimen/_10ssp" />

                    <EditText
                        android:id="@+id/etNewPassword"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:background="@drawable/bg_input_field"
                        android:fontFamily="@font/manrope_regular"
                        android:hint="@string/enter_new_password"
                        android:imeOptions="actionNext"
                        android:inputType="textPassword"
                        android:paddingHorizontal="@dimen/_12sdp"
                        android:textColor="@color/text_color_on_light"
                        android:textColorHint="#98A2B3"
                        android:textSize="@dimen/_10ssp" />

                    <!-- Confirm Password -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:fontFamily="@font/manrope_semibold"
                        android:text="@string/confirm_new_password"
                        android:textColor="@color/btn_navy"
                        android:textSize="@dimen/_10ssp" />

                    <EditText
                        android:id="@+id/etConfirmPassword"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:background="@drawable/bg_input_field"
                        android:fontFamily="@font/manrope_regular"
                        android:hint="@string/re_enter_new_password"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:paddingHorizontal="@dimen/_12sdp"
                        android:textColor="@color/text_color_on_light"
                        android:textColorHint="#98A2B3"
                        android:textSize="@dimen/_10ssp" />

                    <!-- Submit Button inside Card -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnResetPassword"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_42sdp"
                        android:layout_marginTop="@dimen/_16sdp"
                        android:background="@drawable/bg_seat_selected"
                        android:fontFamily="@font/manrope_bold"
                        android:text="@string/reset_password"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/_11ssp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>