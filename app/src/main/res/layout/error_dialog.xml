<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:gravity="center"
    android:background="@drawable/bg_rounded_soft_gold"
    android:orientation="vertical"
    android:padding="@dimen/_5sdp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Payment Error"
        android:fontFamily="@font/manrope_bold"
        android:gravity="center"
        android:textColor="@color/red_textcolor"
        android:textSize="@dimen/_14ssp" />

    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/_5sdp"
        android:fontFamily="@font/manrope_regular"
        android:textAlignment="center"
        android:textColor="@color/text_color_on_light"
        android:textSize="@dimen/_10ssp" />


    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOk"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/_8sdp"
        android:text="Ok"
        android:fontFamily="@font/manrope_regular"
        android:textColor="@color/text_on_navy"
        app:backgroundTint="@color/btn_gold"
        app:cornerRadius="@dimen/_5sdp" />

</LinearLayout>
