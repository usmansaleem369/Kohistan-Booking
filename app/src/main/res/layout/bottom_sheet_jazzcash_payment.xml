<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/_16sdp"
    android:paddingTop="@dimen/_10sdp"
    android:paddingBottom="@dimen/_18sdp">

    <View
        android:layout_width="@dimen/_50sdp"
        android:layout_height="@dimen/_4sdp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/rounded_corners_bg" />


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/manrope_bold"
        android:text="@string/complete_payment"
        android:layout_gravity="center_horizontal"
        android:textColor="@color/btn_navy"
        android:textSize="@dimen/_13ssp" />

    <TextView
        android:id="@+id/tvSheetReservationInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_2sdp"
        android:layout_gravity="center_horizontal"
        android:fontFamily="@font/manrope_regular"
        android:textColor="@color/text_color_on_light"
        android:textSize="@dimen/_9ssp"
        android:layout_marginBottom="@dimen/_10sdp"
        tools:text="Reservation #2611171651542 • Rs. 2,670" />

    <include
        android:id="@+id/layoutPaymentMethod"
        layout="@layout/payment_method" />

    <!-- Pay Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPayJazzCash"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_42sdp"
        android:layout_marginTop="@dimen/_16sdp"
        android:backgroundTint="@color/btn_gold"
        android:fontFamily="@font/manrope_bold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Pay Now"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="@dimen/_11ssp"
        app:cornerRadius="@dimen/_8sdp" />

</LinearLayout>