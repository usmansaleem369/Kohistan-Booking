<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.motion.widget.MotionLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/motionLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/rounded_corners_bg"
    app:layoutDescription="@xml/motion_scene"
    tools:context=".ui.MainActivity">

    <ScrollView
        android:id="@+id/sideMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/side_menu_bg"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <include
            android:id="@+id/sideMenuContent"
            layout="@layout/side_menu_content" />
    </ScrollView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="@dimen/_1sdp"
        app:cardElevation="8dp"
        app:strokeColor="@android:color/transparent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvToolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginHorizontal="@dimen/_3sdp"
                app:cardBackgroundColor="@color/card_bg_warm"
                app:strokeColor="@color/btn_gold"
                app:strokeWidth="1dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/_10sdp">

                    <ImageView
                        android:id="@+id/ivMenu"
                        android:layout_width="@dimen/_18sdp"
                        android:layout_height="@dimen/_18sdp"
                        android:src="@drawable/ic_menu"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/ivProfile"
                        android:layout_width="@dimen/_18sdp"
                        android:layout_height="@dimen/_18sdp"
                        android:src="@drawable/ic_profile"
                        app:layout_constraintStart_toEndOf="@id/ivMenu"
                        app:layout_constraintTop_toTopOf="@id/ivMenu"
                        android:layout_marginStart="@dimen/_10sdp"/>
                    <TextView
                        android:id="@+id/tvDisplayName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_color_on_light"
                        android:text="Usman Saleem"
                        android:fontFamily="@font/manrope_regular"
                        android:layout_marginStart="@dimen/_5sdp"
                        app:layout_constraintTop_toTopOf="@id/ivProfile"
                        app:layout_constraintBottom_toBottomOf="@id/ivProfile"
                        android:textSize="@dimen/_10ssp"
                        app:layout_constraintStart_toEndOf="@id/ivProfile"/>

                    <ImageView
                        android:layout_width="@dimen/_18sdp"
                        android:layout_height="@dimen/_18sdp"
                        android:src="@drawable/ic_notification"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/ivMenu"/>
                    <TextView
                        android:id="@+id/tvTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toBottomOf="@id/ivMenu"
                        android:text="Good Afternoon"
                        android:textSize="@dimen/_10ssp"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:fontFamily="@font/manrope_regular"
                        android:textColor="@color/text_color_on_light"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toBottomOf="@id/tvTime"
                        android:text="@string/let_s_book_your_next_trip"
                        android:textSize="@dimen/_14ssp"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:fontFamily="@font/manrope_extrabold"
                        android:textColor="@color/text_color_on_light"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <FrameLayout
                android:id="@+id/frameLayout"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginHorizontal="@dimen/_3sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cvToolbar" />

            <include
                android:id="@+id/bottomNavigation"
                layout="@layout/bottom_navigation_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:layout_marginVertical="@dimen/_10sdp"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.motion.widget.MotionLayout>
